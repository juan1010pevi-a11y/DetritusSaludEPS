# Copia este archivo como .env (junto a docker-compose.yml) o define estas variables
# en la terminal antes de "npm start". Nunca subas el archivo .env a GitHub.

# mock = los mensajes se registran como "simulados" en la bandeja del portal (no salen a internet)
# live = se envían de verdad por los canales que tengan credenciales
NOTIFICATIONS_MODE=mock

# ---- Correo con Gmail (recomendado para la sustentación) ----
# 1. Activa la verificación en dos pasos de la cuenta de Google.
# 2. Crea una "contraseña de aplicación" en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu.correo@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=tu.correo@gmail.com

# ---- Alternativa de correo: Resend (https://resend.com) ----
RESEND_API_KEY=

# ---- SMS y WhatsApp con Twilio (https://www.twilio.com/try-twilio) ----
# En la cuenta de prueba solo llegan mensajes a números verificados.
# WhatsApp: activa el Sandbox y envía "join <código>" al número del sandbox desde tu celular.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Seguridad (cámbialas en producción) ----
AUTH_SECRET=change-this-in-production
INTERNAL_KEY=change-this-internal-key
