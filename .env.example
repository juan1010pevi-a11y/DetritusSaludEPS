# Variables para "docker compose up". Copia este archivo como .env (junto a docker-compose.yml)
# y reemplaza los valores. Genera valores fuertes con:  cd backend && npm run generar-secretos
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# ---- Secretos obligatorios (sin ellos los contenedores no arrancan) ----
# Firma de los tokens de sesión (JWT). Mínimo 32 caracteres.
AUTH_SECRET=
# Firma de los tokens entre microservicios. Mínimo 32 caracteres.
INTERNAL_KEY=
# Llave AES-256 para cifrar datos clínicos: 32 bytes en base64 (44 caracteres). Si se pierde, no se pueden leer los datos cifrados.
DATA_KEY=
# Usuario propio de RabbitMQ (solo letras, números y _).
RABBITMQ_USER=detritus_app
RABBITMQ_PASS=

# ---- Opciones ----
# 1 = crear cuentas de demostración (sustentación). 0 = sin cuentas demo.
SEED_DEMO=1
# Mostrar la lista de cuentas de prueba en la ventana de ingreso.
VITE_SHOW_DEMO_ACCOUNTS=true
# 1 = médico y administrador DEBEN usar verificación en dos pasos.
MFA_REQUIRED_FOR_STAFF=0
# Orígenes que pueden usar la API (separados por coma).
ALLOWED_ORIGINS=https://localhost:8443
# CAPTCHA (opcional): llaves de https://www.hcaptcha.com
VITE_HCAPTCHA_SITEKEY=
CAPTCHA_SECRET=
